{
  "name": "cv-builder",
  "version": "1.0.0",
  "private": true,
  "description": "Ultimate CV Builder Pro - Multi-platform PWA + Capacitor",
  "scripts": {
    "build": "node -e \"require('fs').cpSync('index.html','www/index.html'); require('fs').cpSync('manifest.json','www/manifest.json'); require('fs').cpSync('service-worker.js','www/service-worker.js'); require('fs').cpSync('icons','www/icons',{recursive:true}); console.log('Built!');\"",
    "deploy": "npm run build && npx cap sync",
    "cap:add:android": "npx cap add android",
    "cap:add:ios": "npx cap add ios",
    "cap:sync": "npx cap sync",
    "cap:open:android": "npx cap open android",
    "cap:open:ios": "npx cap open ios",
    "cap:copy": "npx cap copy"
  },
  "dependencies": {
    "@capacitor/android": "^8.4.1",
    "@capacitor/cli": "^8.4.1",
    "@capacitor/core": "^8.4.1"
  }
}
